<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scripts_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:padding="8dp" />

            <!-- Keyboard Size section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Landscape"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/label_landscape_height"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Height: 160dp"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <SeekBar
                    android:id="@+id/seekbar_landscape_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="80"
                    android:progress="40"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/label_key_width"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Key width: 42dp"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary" />

                <SeekBar
                    android:id="@+id/seekbar_key_width"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="40"
                    android:progress="12"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
