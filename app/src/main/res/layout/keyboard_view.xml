<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_bg"
    android:padding="4dp">

    <!-- Preview/Candidate Bar -->
    <FrameLayout
        android:id="@+id/candidate_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/special_key_bg_color"
        android:layout_marginBottom="4dp">
        <com.akssri.krkey.ui.CandidateView
            android:id="@+id/candidate_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/keyboard_frame"
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <LinearLayout
            android:id="@+id/keyboard_rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!-- One grid per layer, built and cached by KrKeyIME (showGrid) -->
        </LinearLayout>

        <com.akssri.krkey.GestureTrailView
            android:id="@+id/gesture_trail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>